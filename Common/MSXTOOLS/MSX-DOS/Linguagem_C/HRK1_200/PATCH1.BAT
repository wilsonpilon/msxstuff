rem batchfile to concatenate patch programs under MSXDOS-1
rem ONLY RUN THIS ONCE!
rem the original programs are saved as .BAK
rem you must still add the jump instruction and change the
rem exit status address (see documentation)
COPY /B CGEN.COM+CGEN1.COM CGEN2.COM
REN CGEN.COM CGEN.BAK
REN CGEN2.COM CGEN.COM
COPY /B CPP.COM+CPP1.COM CPP2.COM
REN CPP.COM CPP.BAK
REN CPP2.COM CPP.COM
COPY /B CREF.COM+CREF1.COM CREF2.COM
REN CREF.COM CREF.BAK
REN CREF2.COM CREF.COM
COPY /B DEBUG.COM+DEBUG1.COM DEBUG2.COM
REN DEBUG.COM DEBUG.BAK
REN DEBUG2.COM DEBUG.COM
COPY /B LIBR.COM+LIBR1.COM LIBR2.COM
REN LIBR.COM LIBR.BAK
REN LIBR2.COM LIBR.COM
COPY /B OBJTOHEX.COM+OBJTOHX1.COM OBJTOHX2.COM
REN OBJTOHEX.COM OBJTOHEX.BAK
REN OBJTOHX2.COM OBJTOHEX.COM
COPY /B OPTIM.COM+OPTIM1.COM OPTIM2.COM
REN OPTIM.COM OPTIM.BAK
REN OPTIM2.COM OPTIM.COM
COPY /B P1.COM+P11.COM P12.COM
REN P1.COM P1.BAK
REN P12.COM P1.COM
COPY /B ZAS.COM+ZAS1.COM ZAS2.COM
REN ZAS.COM ZAS.BAK
REN ZAS2.COM ZAS.COM
COPY /B LINK.COM+LINK1.COM LINK2.COM
REN LINK.COM LINK.BAK
REN LINK2.COM LINK.COM
