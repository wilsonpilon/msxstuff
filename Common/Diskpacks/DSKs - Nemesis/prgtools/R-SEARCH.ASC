65000 KEYOFF:SCREEN0:WIDTH40:COLOR15,1,1
65010 PRINT:PRINT"        MSX PROGRAM TOOLS 1.0":PRINT
65020 PRINT"     by Nemesis Informatica Ltda":PRINT:PRINT
65030 PRINT"Localizador de "CHR$(34)"REMs"CHR$(34)":":PRINT
65040 PRINT"Imprime? ";:A$=INPUT$(1):BEEP:IFA$="S"ORA$="s"THENC=1
65050 PRINTA$:IFC=1THENLPRINT"Linhas com REM:";
65060 PRINT:PRINT"Linhas com REM:";
65070 E=32769!
65080 B1=PEEK(E)
65090 B2=PEEK(E+1)
65100 B3=PEEK(E+2)
65110 B4=PEEK(E+3)
65120 P=B1+256*B2
65130 A=B3+256*B4
65140 IFA>64999!THEN65230
65150 IFB1=0ANDB2=0THEN65230
65160 FORF=(E+4)TO(P-2)
65170 IFPEEK(F)<>&H8FTHEN65190
65180 F=P-2:PRINTA",";
65190 NEXTF
65200 IFC=1THENLPRINTA",";
65210 E=P
65220 GOTO65080
65230 PRINT:PRINT:PRINT"Finalizado!":PRINT
