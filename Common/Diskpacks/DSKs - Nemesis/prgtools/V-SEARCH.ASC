65000 KEYOFF:SCREEN0:WIDTH40:COLOR15,1,1
65010 PRINT:PRINT"        MSX PROGRAM TOOLS 1.0":PRINT
65020 PRINT"     by Nemesis Informatica Ltda":PRINT:PRINT
65030 PRINT"Localizador de variaveis:":PRINT
65040 POKE&HFCAB,1:C=0
65050 PRINT"Imprime? ";:A$=INPUT$(1):BEEP:PRINTA$:IFA$="S"THENC=1
65060 PRINT:INPUT"Variavel";V$
65070 PRINT:PRINT"Localizada em:";
65080 IFC=1THENLPRINT"Variavel localizada em:";
65090 E=32769!
65100 B1=PEEK(E):B2=PEEK(E+1)
65110 B3=PEEK(E+2):B4=PEEK(E+3)
65120 P=B1+256*B2:N=B3+256*B4
65130 IFB1=0ANDB2=0THEN65280
65140 IFPEEK(E+4)=&H8FTHEN65260
65150 IFPEEK(E+5)=&H8FTHEN65260
65160 L$="":I=0
65170 FORF=(E+4)TO(P-2)
65180 IFPEEK(F)=34THENIP=(I+1)
65190 IFI/2<>I\2THEN65210
65200 L$=L$+CHR$(PEEK(F))
65210 NEXTF
65220 L=INSTR(L$,V$)
65230 IFL=0THEN65260
65240 PRINTSTR$(N)",";
65250 IFC=1THENLPRINTSTR$(N)",";
65260 E=P
65270 GOTO65100
65280 POKE&HFCAB,0
65290 PRINT:PRINT:PRINT"Finalizado!":PRINT
